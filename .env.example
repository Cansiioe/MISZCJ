# Mistral 路由 + HTTP 注册机
#
# 复制为 .env 并填入你的配置。不要把 .env 提交到仓库。

# --- 取码通道: mailapi | selfhost | imap ---
OTP_PROVIDER=mailapi
EMAIL_DOMAIN=your-domain.com

# --- 邮件 API 服务（OTP_PROVIDER=mailapi 时使用）---
MAILAPI_BASE=https://em.example.com/api/v1
MAILAPI_KEY=sk_live_xxxxxxxx
MAILAPI_DOMAIN_ID=<你的域名ID>
# 邮箱有效期（小时），创建时必填
MAILAPI_EXPIRES_HOURS=24
# 1 = 创建永久邮箱（此时不再传 expiresInHours）
MAILAPI_PERMANENT=0

# --- 自建邮箱服务（OTP_PROVIDER=selfhost 时使用）---
# 必须是 自建邮箱服务 站点上的管理员账号，genToken 会校验
SELFHOST_BASE=https://mail.example.com
SELFHOST_ADMIN=admin@example.com
SELFHOST_PASSWORD=your-admin-password
# 1 = 注册前先调 addUser 建好邮箱；0 = 直接用随机地址收信
SELFHOST_CREATE_USER=1

# --- IMAP catch-all（OTP_PROVIDER=imap 时使用）---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@your-domain.com
IMAP_PASS=your-imap-password

# --- 注册机参数 ---
FARM_MODE=http
MAX_ATTEMPTS=20
CONCURRENCY=8
SPAWN_DELAY_S=0.35
OTP_TIMEOUT_S=120
OTP_POLL_S=0.8
SKIP_SMOKE=1
LOGIN_RETRIES=4
RETRY_429_BASE_S=1.5

# --- 代理（高并发时建议配置）---
# 在 config/proxies.ranked.txt 里一行写一个
# 支持格式：http://user:pass@host:port  或  host:port:user:pass
PROXY_FILE=config/proxies.ranked.txt
PROXY_BAN_AFTER=2
# PROXY_URL=http://user:pass@host:port

# --- 路由器 ---
# 只在 data/router.db 里还没有密码时（首次启动）生效。
# 不设置的话会随机生成一个密码，并在路由器日志里打印一次。
# ADMIN_PASSWORD=change-me
# PORT=7623

# --- 上游代理（直连不通时必须设置）---
# 单个代理：
# MISTRAL_PROXY=http://127.0.0.1:7890
# 多个代理（逗号/分号/换行分隔，轮询使用，连续失败自动暂停后重试）：
# MISTRAL_PROXIES=http://127.0.0.1:7890,http://user:pass@host:port
# 连续失败几次后暂停该代理（默认 3），暂停时长（默认 60 秒）
# PROXY_BAN_AFTER=3
# PROXY_BAN_SECONDS=60
# 全部代理都被暂停时是否允许直连（默认 1 允许；设 0 则返回 503）
# PROXY_ALLOW_DIRECT=1

# --- CORS（浏览器直连 /v1 时需要）---
# 默认允许所有来源；生产环境建议限定，例如 https://app.example.com
# CORS_ORIGINS=*

# 请求体大小上限（MB），默认 32。256K 上下文约 1MB 文本，通常够用。
# MAX_BODY_MB=32

# 模型白名单文件（文件不存在或 allow 为空 = 不过滤）
# MODELS_FILE=config/models.available.json

# --- 上游限流（可选，多客户端时建议开启）---
# router 到 api.mistral.ai 的全局请求速率上限，不设则不限速。
# 注意账号限额是「模型级」的：ministral-3b 给 750，codestral 只给 125。
# 多个客户端同时打时建议设个保守值，例如 300。
# UPSTREAM_REQ_PER_MINUTE=300
# 允许的突发量，默认 5。设太大会一次性全放行，等于没限流。
# UPSTREAM_BURST=5

# --- 日志保留 ---
# 自动清理超过 N 天的调用日志；0 = 永久保留。默认 30 天。
# LOG_RETENTION_DAYS=30

# --- 告警通知（可选）---
# 账号池全挂、账号失效、账号自动恢复等事件会推到这里。
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 格式：generic（默认，直接 POST {level,title,message,ts}）/ wecom / dingtalk / feishu / telegram
# ALERT_WEBHOOK_TYPE=wecom
# Telegram 另需：
# ALERT_TELEGRAM_TOKEN=123456:ABC-DEF
# ALERT_TELEGRAM_CHAT=-1001234567890
# 告警默认直连，不走 MISTRAL_PROXY；需要走代理（例如 Telegram）时设 1
# ALERT_USE_PROXY=0

# --- 失效账号自动恢复（可选）---
# 每 N 分钟探测一次失效账号，API Key 仍可用就自动复活。
# 账号被判死的原因不都是真死：网络抖动、代理临时不通也会触发。0 = 关闭。
# AUTO_REVIVE_MINUTES=30

# 监听地址示例（公网 VPS 上建议）：LISTEN_ADDR=127.0.0.1
