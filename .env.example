# Mistral Router + HTTP Farm
#
# Copy to .env and fill in your values. Do not commit .env.

# --- IMAP catch-all (OTP) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@your-domain.com
IMAP_PASS=your-imap-password
EMAIL_DOMAIN=your-domain.com

# --- Farm knobs ---
FARM_MODE=http
MAX_ATTEMPTS=20
CONCURRENCY=8
SPAWN_DELAY_S=0.35
OTP_TIMEOUT_S=120
OTP_POLL_S=0.8
SKIP_SMOKE=1
LOGIN_RETRIES=4
RETRY_429_BASE_S=1.5

# --- Proxies (recommended for high concurrency) ---
# One URL per line in config/proxies.ranked.txt
# Formats: http://user:pass@host:port  OR  host:port:user:pass
PROXY_FILE=config/proxies.ranked.txt
PROXY_BAN_AFTER=2
# PROXY_URL=http://user:pass@host:port

# --- Router ---
# ADMIN_PASSWORD=change-me
# PORT=7623
